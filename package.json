{
  "name": "chrono-lab",
  "version": "0.1.0",
  "description": "A time machine for AI agents",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "vite",
    "build:ui": "vite build",
    "serve": "tsx src/server/main.ts",
    "test": "vitest --run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config tests/e2e/playwright.config.ts",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "fast-check": "3.23.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.4"
  }
}
